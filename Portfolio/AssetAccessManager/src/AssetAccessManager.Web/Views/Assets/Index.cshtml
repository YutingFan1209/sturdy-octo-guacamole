@model IReadOnlyList<AssetAccessManager.Application.AssetListItem>
@{ViewData["Title"]="Asset inventory";}
<h1>Asset inventory</h1><p>Search and atomically assign available laptops.</p>
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
<form method="get" class="row g-2 mb-4"><div class="col"><input class="form-control" name="query" value="@ViewBag.Query" placeholder="Asset tag, serial, or model" /></div><div class="col-auto"><button class="btn btn-primary">Search</button></div></form>
<table class="table align-middle"><thead><tr><th>Tag</th><th>Serial</th><th>Model</th><th>Status</th><th>Assignment</th></tr></thead><tbody>
@foreach(var asset in Model){<tr><td>@asset.AssetTag</td><td>@asset.SerialNumber</td><td>@asset.Model</td><td>@asset.Status</td><td>@if(asset.Status==AssetAccessManager.Domain.AssetStatus.Available){<form asp-action="Assign" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@asset.Id"/><input class="form-control" name="EmployeeId" required maxlength="100" placeholder="Employee ID"/><button class="btn btn-sm btn-success">Assign</button></form>}else{<span class="text-muted">Unavailable</span>}</td></tr>}
</tbody></table>
