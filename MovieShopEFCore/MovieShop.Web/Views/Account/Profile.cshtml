@model MovieShopMVC.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

<dl class="row mt-4">
    <dt class="col-sm-3">User ID</dt>
    <dd class="col-sm-9">@Model.User.Id</dd>

    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.User.FirstName</dd>

    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.User.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.User.Email</dd>
</dl>

<h2 class="h4 mt-5">Purchases</h2>
@if (Model.Purchases.Count == 0)
{
    <p class="text-muted">You have not purchased any movies yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var purchase in Model.Purchases)
        {
            <a asp-controller="Movies" asp-action="Details" asp-route-id="@purchase.MovieId"
               class="list-group-item list-group-item-action d-flex justify-content-between">
                <span>@purchase.MovieTitle</span>
                <span>$@purchase.TotalPrice.ToString("0.00")</span>
            </a>
        }
    </div>
}

<h2 class="h4 mt-5">Favorites</h2>
@if (Model.Favorites.Count == 0)
{
    <p class="text-muted">You have not added any favorites yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var favorite in Model.Favorites)
        {
            <a asp-controller="Movies" asp-action="Details" asp-route-id="@favorite.MovieId"
               class="list-group-item list-group-item-action">@favorite.MovieTitle</a>
        }
    </div>
}
