@model MovieShopMVC.Models.PagedResult<MovieShopMVC.Models.Movie>
@{
    ViewData["Title"] = "Top 30 Highest-Grossing Movies";
}

<h1>Top 30 Highest-Grossing Movies</h1>

<div class="poster-grid">
    @foreach (var movie in Model.Items)
    {
        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
           title="@movie.Title — $@movie.Revenue.ToString("N0")">
            <img src="@movie.PosterUrl" alt="@movie.Title poster" />
        </a>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Top grossing movie pages" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="TopGrossing"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>

            @for (int pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="TopGrossing"
                       asp-route-pageNumber="@pageIndex"
                       asp-route-pageSize="@Model.PageSize">@pageIndex</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="TopGrossing"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
